\@writefile{toc}{\contentsline {section}{\numberline {6.7}Measuring grounded code generation (KodroBench)}{30}{section.6.7}\protected@file@percent }
\newlabel{sec:kodrobench}{{6.7}{30}{Measuring grounded code generation (KodroBench)}{section.6.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.3}{\ignorespaces KodroBench v0.1 (five tasks, ten seeds per task). success@N is mean seeded task success. Invention rate is the fraction of tasks whose program calls a symbol outside the build's fitted-command set. Syntax errors and collisions are the per-task rates. Values are as recorded in the versioned results file \texttt  {results/kodrobench-v0.1.json}, with the human-readable leaderboard alongside it at \texttt  {results/kodrobench-leaderboard.md}. One field is deliberately not tabulated and is disclosed here instead: \texttt  {llama3.2:3b} records \texttt  {gen\_errors: 1}, meaning that on one of its five tasks the model call itself failed and no program was produced. That task is still counted in the denominator, scoring zero success, zero collisions and no syntax error, so the row understates rather than flatters the model. Every other model records zero.}}{31}{table.caption.7}\protected@file@percent }
\newlabel{tab:kodrobench}{{6.3}{31}{KodroBench v0.1 (five tasks, ten seeds per task). success@N is mean seeded task success. Invention rate is the fraction of tasks whose program calls a symbol outside the build's fitted-command set. Syntax errors and collisions are the per-task rates. Values are as recorded in the versioned results file \texttt {results/kodrobench-v0.1.json}, with the human-readable leaderboard alongside it at \texttt {results/kodrobench-leaderboard.md}. One field is deliberately not tabulated and is disclosed here instead: \texttt {llama3.2:3b} records \texttt {gen\_errors: 1}, meaning that on one of its five tasks the model call itself failed and no program was produced. That task is still counted in the denominator, scoring zero success, zero collisions and no syntax error, so the row understates rather than flatters the model. Every other model records zero}{table.caption.7}{}}
